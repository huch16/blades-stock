# Blades Stock — 环境变量模板
# 用法：cp .env.example .env，然后把 <your-token> 换成你自己的强口令。
# .env 已加入 .gitignore，绝不要把它提交进仓库，也不要把真实口令写进任何文档或脚本。

# Web 端访问口令（必填，无默认值）。
# 未设定时服务端首次启动会随机生成一个并固化到 data/auth.token，同时在启动日志里打印一次。
BLADES_AUTH_TOKEN=<your-token>

# 服务监听端口
PORT=8000

# 数据目录（默认 ./data）
BLADES_STOCK_DATA_DIR=./data

# 可选：聚合搜索端点
SEARXNG_URL=https://search.woha.men

# 可选：外部行情/数据服务 API Key（留空表示不启用）
TICKFLOW_API_KEY=

# 可选：Tushare / 悟道 MCP 服务凭证（仅在需要时填写，勿提交）
# TUSHARE_TOKEN=<your-tushare-token>
# WUDAO_BEARER_TOKEN=<your-wudao-token>
